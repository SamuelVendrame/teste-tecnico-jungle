# Camada de mocks (MSW + Socket.IO simulado). Ligada por padrão: só o valor "false"
# desliga (para apontar VITE_API_URL/VITE_SOCKET_URL a um backend real).
VITE_ENABLE_MSW=true
# Base da API simulada. Caminho relativo para funcionar em qualquer host.
VITE_API_URL=/api
# URL do socket simulado (interceptado pelo MSW quando VITE_ENABLE_MSW=true).
VITE_SOCKET_URL=ws://localhost/socket
